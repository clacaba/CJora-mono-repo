{
  "openapi": "3.0.3",
  "info": {
    "title": "CJora proposed account and internal-transfer contracts",
    "version": "0.1.0",
    "description": "DESIGN CONTRACT ONLY. No endpoints, account/ledger tables or posting implementation currently exist. Same-Program same-currency fictional internal transfers; no overdraft, FX, fees, holds or external payments."
  },
  "servers": [
    {
      "url": "https://localhost:7000",
      "description": "Proposed public routes through Gateway -> Core -> Transactions."
    }
  ],
  "security": [
    {
      "ApplicationSession": []
    }
  ],
  "paths": {
    "/api/v1/txn/accounts": {
      "get": {
        "operationId": "listOwnAccounts",
        "tags": [
          "Proposed finance"
        ],
        "description": "Contract only; not implemented. Requires ACCOUNTS.READ.",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 2048
            },
            "description": "Opaque protected cursor bound to account, Program, customer, filters and upper entry sequence."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Scoped result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid UUID, amount/reference, unsupported review version, malformed input or cursor.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Missing, revoked or expired linked session.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Permission, CSRF, Origin or fresh authority rejected.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Resource is unavailable in the authenticated scope; no cross-customer existence details.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Seconds to wait."
              }
            }
          },
          "503": {
            "description": "Dependency or lock/recovery unavailable; outcome may be unknown. Resolve the original intent before retrying.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/txn/transfer-intents": {
      "post": {
        "operationId": "prepareTransferIntent",
        "tags": [
          "Proposed finance"
        ],
        "description": "Contract only; not implemented. Requires TRANSFERS.CREATE and live linked-session validation.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "description": "Nonempty canonical UUID. Scoped by authenticated Program/customer/operation. Reuse unchanged after an uncertain outcome."
          },
          {
            "name": "X-CSRF-TOKEN",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Fresh session-bound token from the existing CSRF endpoint."
          },
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "https://localhost:7000"
              ]
            },
            "description": "Browser supplies the exact origin. Deployment origin must be configured before production."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTransferIntentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Existing result replayed without another posting.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransferIntent"
                }
              }
            }
          },
          "201": {
            "description": "Created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransferIntent"
                }
              }
            }
          },
          "400": {
            "description": "Invalid UUID, amount/reference, unsupported review version, malformed input or cursor.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Missing, revoked or expired linked session.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Permission, CSRF, Origin or fresh authority rejected.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Resource is unavailable in the authenticated scope; no cross-customer existence details.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency conflict, terminal/expired intent or review-session change.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Authorized confirmation rejected: insufficient funds, restricted account, currency or limit policy.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Seconds to wait."
              }
            }
          },
          "503": {
            "description": "Dependency or lock/recovery unavailable; outcome may be unknown. Resolve the original intent before retrying.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
