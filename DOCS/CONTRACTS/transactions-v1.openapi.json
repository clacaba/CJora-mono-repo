  "components": {
    "securitySchemes": {
      "ApplicationSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-cjora-session",
        "description": "Existing opaque HttpOnly application cookie, never an IdP access token in browser storage."
      }
    },
    "schemas": {
      "Amount": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "currency": {
            "type": "string",
            "enum": [
              "PHP",
              "SGD",
              "USD",
              "JPY",
              "KWD"
            ],
            "description": "Verified catalog only; the Program must explicitly enable the currency."
          },
          "minorUnits": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$",
            "maxLength": 19,
            "description": "Canonical integer minor units, maximum 9223372036854775807. Server validates the numeric bound; never use a JSON number."
          }
        },
        "required": [
          "currency",
          "minorUnits"
        ]
      },
      "CreateTransferIntentRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sourceAccountUuid": {
            "type": "string",
            "format": "uuid"
          },
          "destinationAccountUuid": {
            "type": "string",
            "format": "uuid"
          },
          "amount": {
            "$ref": "#/components/schemas/Amount"
          },
          "reference": {
            "type": "string",
            "nullable": true,
            "maxLength": 140,
            "pattern": "^[ -~]*$"
          }
        },
        "required": [
          "sourceAccountUuid",
          "destinationAccountUuid",
          "amount"
        ]
      },
      "ConfirmTransferIntentRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reviewVersion": {
            "type": "integer",
            "enum": [
              1
            ]
          }
        },
        "required": [
          "reviewVersion"
        ]
      },
      "Account": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "accountUuid": {
            "type": "string",
            "format": "uuid"
          },
          "label": {
            "type": "string",
            "maxLength": 80
          },
          "currency": {
            "type": "string",
            "enum": [
              "PHP",
              "SGD",
              "USD",
              "JPY",
              "KWD"
            ],
            "description": "Verified catalog only; the Program must explicitly enable the currency."
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "RESTRICTED",
              "CLOSED"
            ]
          },
          "postedMinor": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,18})$",
            "maxLength": 19,
            "description": "Canonical integer minor units, maximum 9223372036854775807. Server validates the numeric bound; never use a JSON number."
          },
          "availableMinor": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,18})$",
            "maxLength": 19,
            "description": "Canonical integer minor units, maximum 9223372036854775807. Server validates the numeric bound; never use a JSON number."
          }
        },
        "required": [
          "accountUuid",
          "label",
          "currency",
          "status",
          "postedMinor",
          "availableMinor"
        ]
      },
      "AccountPage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/Account"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      },
      "TransferIntent": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "intentUuid": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "enum": [
              "PREPARED",
              "POSTED",
              "REJECTED",
              "EXPIRED"
            ]
          },
          "reviewVersion": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "sourceAccountUuid": {
            "type": "string",
            "format": "uuid"
          },
          "destinationAccountUuid": {
            "type": "string",
            "format": "uuid"
          },
          "destinationLabel": {
            "type": "string",
            "maxLength": 80
          },
          "amount": {
            "$ref": "#/components/schemas/Amount"
          },
