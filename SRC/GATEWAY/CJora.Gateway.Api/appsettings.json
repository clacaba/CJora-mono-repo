                                                        "tpp":  "http://localhost:5077",
                                                        "core":  "http://localhost:5075",
                                                        "identity-management":  "http://localhost:5076",
                                                        "documents":  "http://localhost:5082",
                                                        "notifications":  "http://localhost:5081"
                                                    }
                       },
    "GatewayBridge":  {
                          "CoreAddress":  "http://localhost:5075"
                      }
}