{
  "Urls": "http://localhost:5080",
  "AllowedHosts": "localhost;127.0.0.1",
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "ReverseProxy": {
    "Routes": {
      "coreApi": { "ClusterId": "core", "Match": { "Path": "/api/v1/{**remainder}" } }
    },
    "Clusters": {
      "core": { "HttpRequest": { "ActivityTimeout": "00:00:30" }, "Destinations": { "local": { "Address": "http://localhost:5075/" } } }
    }
  }
}